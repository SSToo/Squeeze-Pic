{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squeeze Pic",
  "version": "0.2.2",
  "identifier": "com.squeeze.pic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Squeeze Pic", "width": 1280, "height": 880, "minWidth": 980, "minHeight": 720 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1421 ws://127.0.0.1:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/squeeze-pic-worker"],
    "resources": { "../third-party/": "third-party/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" },
    "windows": { "webviewInstallMode": { "type": "offlineInstaller" } }
  }
}
